# Python env
venv/
__pycache__/
*.pyc

# Your active feed list (copy an example to create it)
feeds.txt

# Generated digests, extras and logs (personal / regenerated daily)
feeds-digest.md
feeds-digest.json
feeds-digest.log
digests/
extras/
fulltext/
run-briefing.log
launchd-out.log
launchd-err.log

# Shared state and reading history — personal, never commit
state.json
news-watch-history.md
historique-veille.md
archives/

# Personal hooks (only the README and *.example templates are tracked)
hooks/post-digest.d/*
!hooks/post-digest.d/README.md
!hooks/post-digest.d/*.example

# Secrets — session cookies, API keys, tokens
*cookie*
*.cookies
.env
*.key
*token*

# Backups and OS cruft
*.bak
*.bak-*
.DS_Store
