<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — replace {{REPO_DIR}} with the ABSOLUTE path to your clone,
  e.g. /Users/you/bin/rss-news-watch  (no trailing slash), then:

    sed "s|{{REPO_DIR}}|$HOME/bin/rss-news-watch|g" \
      scheduler/macos-launchd.plist.template \
      > ~/Library/LaunchAgents/com.rss-news-watch.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rss-news-watch.plist

  It runs run-briefing.sh every day at 07:30 (tweak Hour/Minute below). Keep it
  DAILY even if your LLM task runs only a few times a week: the digests pile up
  in digests/ and are consumed together by the next briefing.
  The wrapper waits for the network and retries, so 07:30 leaves margin before
  an 08:00+ LLM task.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rss-news-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{REPO_DIR}}/run-briefing.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{REPO_DIR}}/launchd-out.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO_DIR}}/launchd-err.log</string>
</dict>
</plist>
